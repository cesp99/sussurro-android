<?xml version="1.0" encoding="utf-8"?>
<!--
    Capability advertisement for the phone. The watch uses CapabilityClient
    with the name `sussurro_phone` (see WearableProtocol.CAPABILITY_PHONE)
    to discover which paired node is running the phone-side companion.
-->
<wearable>
    <capabilities>
        <capability name="sussurro_phone" />
    </capabilities>
</wearable>
