<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Used to keep the recording service alive while the user is dictating. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Marks this APK as the wearable companion to the phone module
             that shares `de.aploi.sussurrobyeyed` as its applicationId. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Capability advertisement: lets the phone find this watch via
             CapabilityClient. Path matches WearableProtocol.CAPABILITY_WATCH. -->
        <meta-data
            android:name="com.google.android.wearable.capability.declarations"
            android:resource="@xml/wear_capabilities" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground microphone service that owns the recording loop and
             keeps the watch from killing it when the user lowers their wrist. -->
        <service
            android:name=".session.WatchSessionService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Wearable listener for state messages from the phone. -->
        <service
            android:name=".session.WatchMessageListener"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/sussurro/phone"
                    android:scheme="wear" />
            </intent-filter>
        </service>

    </application>

</manifest>
