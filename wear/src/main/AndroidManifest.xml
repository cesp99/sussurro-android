<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Used to keep the recording service alive while the user is dictating. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <application
        android:name=".SussurroWearApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Marks this APK as the wearable companion to the phone module
             that shares `de.aploi.sussurrobyeyed` as its applicationId. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Capability advertisement is in res/values/wear.xml — that's
             the only static-declaration path Google Play Services actually
             reads. The earlier `<meta-data ... capability.declarations />`
             form is not a real Wear OS API and was silently dropped on the
             floor by GMS, leaving the phone unable to discover the watch. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground microphone service that owns the recording loop and
             keeps the watch from killing it when the user lowers their wrist. -->
        <service
            android:name=".session.WatchSessionService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Wearable listener for state messages from the phone. -->
        <service
            android:name=".session.WatchMessageListener"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/sussurro/phone"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- Wear OS Tile: drops a "Tap to dictate" surface onto the watch's
             tile carousel. Tapping the tile launches MainActivity, which
             handles the rest of the session. The BIND_TILE_PROVIDER
             permission is system-only; the system Wear OS process is the
             only caller allowed. -->
        <service
            android:name=".tile.SussurroTileService"
            android:exported="true"
            android:label="@string/tile_brand"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>

            <!-- Optional preview shown in the tile picker. We re-use the
                 launcher icon as the cheapest path; once we have a tile-
                 specific preview drawable we can swap this for it. -->
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@mipmap/ic_launcher" />
        </service>

    </application>

</manifest>
