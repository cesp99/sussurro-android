<?xml version="1.0" encoding="utf-8"?>
<!--
    Capability advertisement for the watch. The phone uses CapabilityClient
    with the name `sussurro_watch` (see WearableProtocol.CAPABILITY_WATCH)
    to discover the paired Sussurro-capable watch node.
-->
<wearable>
    <capabilities>
        <capability name="sussurro_watch" />
    </capabilities>
</wearable>
